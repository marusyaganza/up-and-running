{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDirs": [
      "src"
    ], 
    "types": [],
    "declaration": true,
    "outDir": "dist",
    "stripInternal": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "esModuleInterop": false,
    "skipLibCheck": false
  },
  "include": ["src"],
  "exclude": ["**/test", "**/*.test.ts"]
}